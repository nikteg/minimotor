{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@src/*": ["../src/*"],
      "minimotor": ["../build/index.d.ts"],
      "minimotor/audio": ["../build/audio/index.d.ts"],
      "minimotor/animation": ["../build/anim/index.d.ts"],
      "minimotor/ecs": ["../build/ecs/index.d.ts"],
      "minimotor/sprites": ["../build/sprites/index.d.ts"],
      "minimotor/aseprite": ["../build/aseprite/index.d.ts"],
      "minimotor/assets": ["../build/assets/index.d.ts"],
      "minimotor/camera": ["../build/camera/index.d.ts"],
      "minimotor/debug": ["../build/debug/index.d.ts"],
      "minimotor/input": ["../build/input/index.d.ts"],
      "minimotor/ldtk": ["../build/ldtk/index.d.ts"],
      "minimotor/onscreen-input": ["../build/onscreen/index.d.ts"],
      "minimotor/net": ["../build/net/index.d.ts"],
      "minimotor/particles": ["../build/particles/index.d.ts"],
      "minimotor/platformer": ["../build/platformer/index.d.ts"],
      "minimotor/portals": ["../build/portals/index.d.ts"],
      "minimotor/scenes": ["../build/scenes/index.d.ts"],
      "minimotor/storage": ["../build/storage/index.d.ts"],
      "minimotor/timers": ["../build/timers/index.d.ts"],
      "minimotor/ui": ["../build/ui/index.d.ts"],
      "minimotor/physics2d": ["../build/physics2d/index.d.ts"],
      "minimotor/performance": ["../build/perf/index.d.ts"],
      "minimotor/snapshots": ["../build/snapshots/index.d.ts"],
      "minimotor/autosave": ["../build/autosave/index.d.ts"],
      "minimotor/capture": ["../build/capture/index.d.ts"],
      "minimotor/rng": ["../build/rng/index.d.ts"],
      "minimotor/server": ["../build/net/server/index.d.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}

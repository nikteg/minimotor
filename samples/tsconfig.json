{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "minimotor": ["../build/index.d.ts"],
      "minimotor/animation": ["../build/features/animation/index.d.ts"],
      "minimotor/aseprite": ["../build/aseprite/index.d.ts"],
      "minimotor/assets": ["../build/assets.d.ts"],
      "minimotor/audio": ["../build/features/audio/index.d.ts"],
      "minimotor/camera": ["../build/camera/index.d.ts"],
      "minimotor/debug": ["../build/debug.d.ts"],
      "minimotor/input": ["../build/features/input/index.d.ts"],
      "minimotor/ldtk": ["../build/ldtk/index.d.ts"],
      "minimotor/onscreen-input": ["../build/features/onscreen-input/index.d.ts"],
      "minimotor/net": ["../build/features/networking/index.d.ts"],
      "minimotor/particles": ["../build/particles.d.ts"],
      "minimotor/performance": ["../build/features/performance-monitoring.d.ts"],
      "minimotor/platformer": ["../build/features/platformer/index.d.ts"],
      "minimotor/portals": ["../build/portals.d.ts"],
      "minimotor/scenes": ["../build/scenes.d.ts"],
      "minimotor/storage": ["../build/features/storage.d.ts"],
      "minimotor/snapshots": ["../build/features/snapshots.d.ts"],
      "minimotor/autosave": ["../build/features/autosave.d.ts"],
      "minimotor/capture": ["../build/features/capture.d.ts"],
      "minimotor/accessibility": ["../build/features/accessibility.d.ts"],
      "minimotor/replay": ["../build/features/replay.d.ts"],
      "minimotor/determinism": ["../build/features/determinism.d.ts"],
      "minimotor/timers": ["../build/features/timers/index.d.ts"],
      "minimotor/ui": ["../build/features/ui/index.d.ts"],
      "minimotor/physics2d": ["../build/physics2d.d.ts"],
      "minimotor/server": ["../build/server.d.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}

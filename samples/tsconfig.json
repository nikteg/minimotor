{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "minimotor": ["../build/index.d.ts"],
      "minimotor/audio": ["../build/audio/service.d.ts"],
      "minimotor/animation": ["../build/anim/service.d.ts"],
      "minimotor/aseprite": ["../build/aseprite/index.d.ts"],
      "minimotor/assets": ["../build/assets/service.d.ts"],
      "minimotor/camera": ["../build/camera/service.d.ts"],
      "minimotor/debug": ["../build/debug/service.d.ts"],
      "minimotor/input": ["../build/input/service.d.ts"],
      "minimotor/ldtk": ["../build/ldtk/index.d.ts"],
      "minimotor/onscreen-input": ["../build/onscreen/service.d.ts"],
      "minimotor/net": ["../build/net/service.d.ts"],
      "minimotor/particles": ["../build/particles/service.d.ts"],
      "minimotor/platformer": ["../build/platformer/index.d.ts"],
      "minimotor/portals": ["../build/portals/service.d.ts"],
      "minimotor/scenes": ["../build/scenes/service.d.ts"],
      "minimotor/storage": ["../build/storage/service.d.ts"],
      "minimotor/timers": ["../build/timers/service.d.ts"],
      "minimotor/ui": ["../build/ui/service.d.ts"],
      "minimotor/physics2d": ["../build/physics2d/service.d.ts"],
      "minimotor/performance": ["../build/perf/service.d.ts"],
      "minimotor/snapshots": ["../build/snapshots.d.ts"],
      "minimotor/autosave": ["../build/autosave/service.d.ts"],
      "minimotor/capture": ["../build/capture/service.d.ts"],
      "minimotor/accessibility": ["../build/accessibility.d.ts"],
      "minimotor/replay": ["../build/replay.d.ts"],
      "minimotor/determinism": ["../build/determinism.d.ts"],
      "minimotor/server": ["../build/server.d.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}

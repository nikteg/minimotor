{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "minimotor": ["../build/index.d.ts"],
      "minimotor/physics2d": ["../build/physics2d.d.ts"],
      "minimotor/server": ["../build/server.d.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}

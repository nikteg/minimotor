{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    // WebGPU is not in TypeScript's bundled dom lib yet, and src/render3d
    // reaches into it.
    "types": ["@webgpu/types"],
    "paths": {
      "@src/*": ["../src/*"],
      "minimotor": ["../src/index.ts"],
      "minimotor/audio": ["../src/audio/index.ts"],
      "minimotor/animation": ["../src/anim/index.ts"],
      "minimotor/ecs": ["../src/ecs/index.ts"],
      "minimotor/sprites": ["../src/sprites/index.ts"],
      "minimotor/aseprite": ["../src/aseprite/index.ts"],
      "minimotor/assets": ["../src/assets/index.ts"],
      "minimotor/camera": ["../src/camera/index.ts"],
      "minimotor/debug": ["../src/debug/index.ts"],
      "minimotor/input": ["../src/input/index.ts"],
      "minimotor/ldtk": ["../src/ldtk/index.ts"],
      "minimotor/onscreen-input": ["../src/onscreen/index.ts"],
      "minimotor/net": ["../src/net/index.ts"],
      "minimotor/particles": ["../src/particles/index.ts"],
      "minimotor/3d": ["../src/render3d/index.ts"],
      "minimotor/platformer": ["../src/platformer/index.ts"],
      "minimotor/portals": ["../src/portals/index.ts"],
      "minimotor/procgen": ["../src/procgen/index.ts"],
      "minimotor/scenes": ["../src/scenes/index.ts"],
      "minimotor/storage": ["../src/storage/index.ts"],
      "minimotor/timers": ["../src/timers/index.ts"],
      "minimotor/ui": ["../src/ui/index.ts"],
      "minimotor/hot-reload": ["../src/hot/index.ts"],
      "minimotor/physics2d": ["../src/physics2d/index.ts"],
      "minimotor/performance": ["../src/perf/index.ts"],
      "minimotor/snapshots": ["../src/snapshots/index.ts"],
      "minimotor/autosave": ["../src/autosave/index.ts"],
      "minimotor/capture": ["../src/capture/index.ts"],
      "minimotor/rng": ["../src/rng/index.ts"],
      "minimotor/server": ["../src/net/server/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}

{
  // Compiles the WebSocket sidecar (tools/serve.ts) and its import graph — the
  // road-rivals server, the signaling relay and the engine source they reach —
  // to plain runnable ESM under server-dist/, preserving structure so the
  // `.js`-into-`.ts` relative imports resolve at runtime. No bundler: the only
  // runtime dependency is `ws` (from node_modules). Run: node server-dist/tools/serve.js
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "noUnusedLocals": false,
    "rootDir": ".",
    "outDir": "./server-dist",
    "noEmitOnError": true
  },
  "include": ["tools/serve.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}

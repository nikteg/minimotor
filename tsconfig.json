{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    // WebGPU is not in TypeScript's bundled dom lib yet; @webgpu/types adds it.
    "types": ["node", "@webgpu/types"],
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "@src/*": ["./src/*"]
    },
    "declaration": true,
    "outDir": "./build",
    "rootDir": "src",
    "noEmitOnError": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/cli/__examples"]
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true
  },
  "rules": {
    // Engine and rectsOverlap are intentional globals consumed by
    // classic scripts in game projects (no module boundary).
    "no-unused-vars": "off"
  },
  "ignorePatterns": ["*.js", "*.d.ts", "build/"]
}

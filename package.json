{
  "name": "minimotor",
  "version": "0.2.0",
  "description": "Minimal 2D canvas framework — fixed-step loop, drawing, input, collision, audio — for small games and playful apps",
  "homepage": "https://github.com/nikteg/minimotor#readme",
  "bugs": "https://github.com/nikteg/minimotor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikteg/minimotor.git"
  },
  "bin": {
    "mm": "./build/cli/index.js"
  },
  "files": [
    "build",
    "src/cli/__examples",
    "README.md",
    "tsconfig.web.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./audio": {
      "types": "./build/audio/service.d.ts",
      "default": "./build/audio/service.js"
    },
    "./animation": {
      "types": "./build/anim/service.d.ts",
      "default": "./build/anim/service.js"
    },
    "./aseprite": {
      "types": "./build/aseprite/index.d.ts",
      "default": "./build/aseprite/index.js"
    },
    "./assets": {
      "types": "./build/assets/service.d.ts",
      "default": "./build/assets/service.js"
    },
    "./camera": {
      "types": "./build/camera/service.d.ts",
      "default": "./build/camera/service.js"
    },
    "./debug": {
      "types": "./build/debug/service.d.ts",
      "default": "./build/debug/service.js"
    },
    "./input": {
      "types": "./build/input/service.d.ts",
      "default": "./build/input/service.js"
    },
    "./ldtk": {
      "types": "./build/ldtk/index.d.ts",
      "default": "./build/ldtk/index.js"
    },
    "./onscreen-input": {
      "types": "./build/onscreen/service.d.ts",
      "default": "./build/onscreen/service.js"
    },
    "./net": {
      "types": "./build/net/service.d.ts",
      "default": "./build/net/service.js"
    },
    "./particles": {
      "types": "./build/particles/service.d.ts",
      "default": "./build/particles/service.js"
    },
    "./platformer": {
      "types": "./build/platformer/index.d.ts",
      "default": "./build/platformer/index.js"
    },
    "./portals": {
      "types": "./build/portals/service.d.ts",
      "default": "./build/portals/service.js"
    },
    "./scenes": {
      "types": "./build/scenes/service.d.ts",
      "default": "./build/scenes/service.js"
    },
    "./storage": {
      "types": "./build/storage/service.d.ts",
      "default": "./build/storage/service.js"
    },
    "./timers": {
      "types": "./build/timers/service.d.ts",
      "default": "./build/timers/service.js"
    },
    "./ui": {
      "types": "./build/ui/service.d.ts",
      "default": "./build/ui/service.js"
    },
    "./physics2d": {
      "types": "./build/physics2d/service.d.ts",
      "default": "./build/physics2d/service.js"
    },
    "./performance": {
      "types": "./build/perf/service.d.ts",
      "default": "./build/perf/service.js"
    },
    "./snapshots": {
      "types": "./build/snapshots.d.ts",
      "default": "./build/snapshots.js"
    },
    "./autosave": {
      "types": "./build/autosave/service.d.ts",
      "default": "./build/autosave/service.js"
    },
    "./capture": {
      "types": "./build/capture/service.d.ts",
      "default": "./build/capture/service.js"
    },
    "./accessibility": {
      "types": "./build/accessibility.d.ts",
      "default": "./build/accessibility.js"
    },
    "./replay": {
      "types": "./build/replay.d.ts",
      "default": "./build/replay.js"
    },
    "./determinism": {
      "types": "./build/determinism.d.ts",
      "default": "./build/determinism.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./build/server.js"
    },
    "./cli": {
      "types": "./build/cli/index.d.ts",
      "default": "./build/cli/index.js"
    },
    "./cli/*": {
      "types": "./build/cli/features/*.feature.d.ts",
      "default": "./build/cli/features/*.feature.js"
    }
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "rm -rf build && tsc",
    "dev": "tsc --watch",
    "prepare": "rm -rf build && tsc",
    "samples": "mm dev",
    "samples:build": "vite build",
    "samples:preview": "vite preview",
    "server:build": "tsc -p tsconfig.server.json",
    "docs:api": "node tools/gen-api-docs.ts",
    "api-lab:levels": "mm level build tools/api-lab-levels.mjs --skin tools/api-lab-levels.mjs --template samples/api-lab/assets/api-lab.ldtk -o samples/api-lab/assets/api-lab.ldtk",
    "ldtk:types": "mm ldtk types samples/api-lab/assets/api-lab.ldtk -o samples/api-lab/api-lab.generated.ts",
    "test:e2e": "mm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt .",
    "verify:tsc": "tsc --noEmit",
    "verify:samples": "tsc -p samples/tsconfig.json",
    "verify:lint": "oxlint",
    "verify:format": "oxfmt --check .",
    "verify:assets": "mm assets check samples/api-lab",
    "verify:cli": "mm --help",
    "verify:generated": "pnpm ldtk:types --check",
    "verify:ldtk": "mm ldtk check samples/api-lab/assets/api-lab.ldtk",
    "verify:level-design": "pnpm api-lab:levels --check && mm level check samples/api-lab/assets/api-lab.ldtk --portal-boundaries --reciprocal-portals",
    "verify": "pnpm build && pnpm run --parallel \"/^verify:.+$/\""
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "minimotor": "link:.",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.36.0",
    "planck": "^1.5.0",
    "shiki": "^4.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "planck": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "planck": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}

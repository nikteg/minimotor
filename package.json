{
  "name": "minimotor",
  "version": "0.2.0",
  "description": "Minimal 2D canvas framework — fixed-step loop, drawing, input, collision, audio — for small games and playful apps",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./physics2d": {
      "types": "./build/physics2d.d.ts",
      "default": "./build/physics2d.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./build/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "samples": "vite",
    "samples:build": "vite build",
    "samples:preview": "vite preview",
    "server:build": "tsc -p tsconfig.server.json",
    "docs:api": "node tools/gen-api-docs.ts",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt .",
    "verify:tsc": "tsc --noEmit",
    "verify:samples": "tsc -p samples/tsconfig.json",
    "verify:lint": "oxlint",
    "verify:format": "oxfmt --check .",
    "verify": "pnpm run --parallel \"/^verify:.+$/\""
  },
  "dependencies": {
    "planck": "^1.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.36.0",
    "shiki": "^4.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}

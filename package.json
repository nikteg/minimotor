{
  "name": "minimotor",
  "version": "0.2.0",
  "description": "Minimal game loop + collision helpers + audio for small 2D canvas games",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "oxfmt .",
    "verify:tsc": "tsc --noEmit",
    "verify:lint": "oxlint",
    "verify:format": "oxfmt --check .",
    "verify": "pnpm run --parallel \"/^verify:.+$/\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.36.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}

{
  "name": "minimotor",
  "version": "0.2.0",
  "description": "Minimal 2D canvas framework — fixed-step loop, drawing, input, collision, audio — for small games and playful apps",
  "homepage": "https://github.com/nikteg/minimotor#readme",
  "bugs": "https://github.com/nikteg/minimotor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikteg/minimotor.git"
  },
  "bin": {
    "mm": "./build/cli/index.js"
  },
  "files": [
    "build",
    "src/cli/__examples",
    "README.md",
    "tsconfig.web.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./audio": {
      "types": "./build/audio/index.d.ts",
      "default": "./build/audio/index.js"
    },
    "./animation": {
      "types": "./build/anim/index.d.ts",
      "default": "./build/anim/index.js"
    },
    "./aseprite": {
      "types": "./build/aseprite/index.d.ts",
      "default": "./build/aseprite/index.js"
    },
    "./assets": {
      "types": "./build/assets/index.d.ts",
      "default": "./build/assets/index.js"
    },
    "./ecs": {
      "types": "./build/ecs/index.d.ts",
      "default": "./build/ecs/index.js"
    },
    "./sprites": {
      "types": "./build/sprites/index.d.ts",
      "default": "./build/sprites/index.js"
    },
    "./camera": {
      "types": "./build/camera/index.d.ts",
      "default": "./build/camera/index.js"
    },
    "./debug": {
      "types": "./build/debug/index.d.ts",
      "default": "./build/debug/index.js"
    },
    "./input": {
      "types": "./build/input/index.d.ts",
      "default": "./build/input/index.js"
    },
    "./ldtk": {
      "types": "./build/ldtk/index.d.ts",
      "default": "./build/ldtk/index.js"
    },
    "./onscreen-input": {
      "types": "./build/onscreen/index.d.ts",
      "default": "./build/onscreen/index.js"
    },
    "./net": {
      "types": "./build/net/index.d.ts",
      "default": "./build/net/index.js"
    },
    "./particles": {
      "types": "./build/particles/index.d.ts",
      "default": "./build/particles/index.js"
    },
    "./platformer": {
      "types": "./build/platformer/index.d.ts",
      "default": "./build/platformer/index.js"
    },
    "./procgen": {
      "types": "./build/procgen/index.d.ts",
      "default": "./build/procgen/index.js"
    },
    "./portals": {
      "types": "./build/portals/index.d.ts",
      "default": "./build/portals/index.js"
    },
    "./scenes": {
      "types": "./build/scenes/index.d.ts",
      "default": "./build/scenes/index.js"
    },
    "./storage": {
      "types": "./build/storage/index.d.ts",
      "default": "./build/storage/index.js"
    },
    "./timers": {
      "types": "./build/timers/index.d.ts",
      "default": "./build/timers/index.js"
    },
    "./ui": {
      "types": "./build/ui/index.d.ts",
      "default": "./build/ui/index.js"
    },
    "./hot": {
      "types": "./build/hot/index.d.ts",
      "default": "./build/hot/index.js"
    },
    "./physics2d": {
      "types": "./build/physics2d/index.d.ts",
      "default": "./build/physics2d/index.js"
    },
    "./performance": {
      "types": "./build/perf/index.d.ts",
      "default": "./build/perf/index.js"
    },
    "./snapshots": {
      "types": "./build/snapshots/index.d.ts",
      "default": "./build/snapshots/index.js"
    },
    "./autosave": {
      "types": "./build/autosave/index.d.ts",
      "default": "./build/autosave/index.js"
    },
    "./capture": {
      "types": "./build/capture/index.d.ts",
      "default": "./build/capture/index.js"
    },
    "./rng": {
      "types": "./build/rng/index.d.ts",
      "default": "./build/rng/index.js"
    },
    "./server": {
      "types": "./build/net/server/index.d.ts",
      "default": "./build/net/server/index.js"
    },
    "./cli": {
      "types": "./build/cli/index.d.ts",
      "default": "./build/cli/index.js"
    },
    "./cli/*": {
      "types": "./build/cli/features/*.d.ts",
      "default": "./build/cli/features/*.js"
    }
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "rm -rf build && tsc && tsc-alias && cp -r src/cli/schemas build/cli/schemas",
    "dev": "concurrently --kill-others \"tsc --watch\" \"tsc-alias --watch\"",
    "prepare": "rm -rf build && tsc && tsc-alias && cp -r src/cli/schemas build/cli/schemas",
    "samples": "vite --host",
    "samples:build": "vite build",
    "samples:preview": "vite preview",
    "server:build": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "docs:api": "node tools/gen-api-docs.ts",
    "api-lab:levels": "mm level build tools/api-lab-levels.mjs --skin tools/api-lab-levels.mjs --template samples/api-lab/assets/api-lab.ldtk -o samples/api-lab/assets/api-lab.ldtk",
    "ldtk:types": "mm ldtk types samples/api-lab/assets/api-lab.ldtk -o samples/api-lab/api-lab.generated.ts",
    "procgen:golden": "mm procgen gen dungeon --seed 7 --cols 64 --rows 40 --locks 2 -o tools/procgen-golden.txt",
    "test:e2e": "mm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt .",
    "verify:tsc": "tsc --noEmit",
    "verify:samples": "tsc -p samples/tsconfig.json",
    "verify:lint": "oxlint",
    "verify:format": "oxfmt --check .",
    "verify:assets": "mm assets check samples/api-lab",
    "verify:cli": "mm --help",
    "verify:generated": "pnpm ldtk:types --check",
    "verify:procgen": "pnpm procgen:golden --check",
    "verify:ldtk": "mm ldtk check samples/api-lab/assets/api-lab.ldtk",
    "verify:level-design": "pnpm api-lab:levels --check && mm level check samples/api-lab/assets/api-lab.ldtk --portal-boundaries --reciprocal-portals",
    "verify": "pnpm build && pnpm run --parallel \"/^verify:.+$/\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "minimotor": "link:.",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.36.0",
    "planck": "^1.5.0",
    "shiki": "^4.3.1",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "planck": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "planck": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
